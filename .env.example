APP_ENV=development
LOG_LEVEL=INFO

API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

WEB_HOST=127.0.0.1
WEB_PORT=4173
VITE_API_BASE_URL=http://127.0.0.1:8000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=demand_atlas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/demand_atlas

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DemandAtlas/0.1 by augus
REDDIT_BASE_URL=https://oauth.reddit.com
REDDIT_TOKEN_URL=https://www.reddit.com/api/v1/access_token
REDDIT_FETCH_LIMIT_PER_SOURCE=12
REDDIT_COMMENT_LIMIT_PER_POST=12

ONE_CLICK_CACHE_MAX_AGE_SECONDS=21600
DIRECTED_CACHE_MAX_AGE_SECONDS=21600
ONE_CLICK_CACHE_ALLOW_PARTIAL_SUCCESS=false
DIRECTED_CACHE_ALLOW_PARTIAL_SUCCESS=false

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Host port bindings for shared test servers
POSTGRES_BIND_PORT=5432
REDIS_BIND_PORT=6379
MINIO_BIND_PORT=9000
MINIO_CONSOLE_BIND_PORT=9001

